APP_NAME=Embryo Matrix
DATABASE_URL=postgresql+psycopg://embryomatrix:CHANGE_ME@localhost:5432/embryomatrix
# Optional — set these after deploying apps_script/Code.gs as a Web App.
# SHEET_API_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# SHEET_API_TOKEN=same-secret-you-set-in-the-script's-setup()-function

# This app has no login of its own — it must run behind a trusted reverse
# proxy / parent application that authenticates the user and forwards their
# identity via the X-Auth-User / X-Auth-Role request headers, stripping any
# copies of those headers a client tried to set itself. Do not expose this
# service directly (e.g. bind it to 127.0.0.1 and let the proxy be the only
# thing reachable on the network).
IMAGE_SYNC_TOKEN=

# Pipe-separated Google Sheet IDs to sync (required for live sync)
SHEET_SOURCES=
