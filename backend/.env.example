APP_NAME=Embryo Matrix
DATABASE_URL=postgresql+psycopg://embryomatrix:CHANGE_ME@localhost:5432/embryomatrix
# Optional — set these after deploying apps_script/Code.gs as a Web App.
# SHEET_API_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# SHEET_API_TOKEN=same-secret-you-set-in-the-script's-setup()-function

# This app has no login of its own — it must run behind a trusted reverse
# proxy / parent application that authenticates the user and forwards their
# identity via the X-Auth-User / X-Auth-Role request headers, stripping any
# copies of those headers a client tried to set itself. Do not expose this
# service directly (e.g. bind it to 127.0.0.1 and let the proxy be the only
# thing reachable on the network).
IMAGE_SYNC_TOKEN=

# Pipe-separated Google Sheet IDs to sync (required for live sync)
SHEET_SOURCES=

# Interim built-in login (users managed with: python tools/manage_users.py add|passwd|remove|list).
# Set to false once the app sits behind the company login, which then supplies X-Auth-User / X-Auth-Role.
BUILTIN_LOGIN=false

# Where the Edits sheet button opens (the shared Google Sheet with the edited samples). Blank = the sheet the Apps Script created.
EDITS_SHEET_URL=

# ---------------------------------------------------------------------------
# IT genetics integration service (backend/app/integration_client.py).
# INERT until INTEGRATION_ENABLED=true AND auth is set - the live Google-Sheet
# flows are untouched until then.
# AUTH: the service account username/password (same account the Report-Automation
# project uses against this service). The client POSTs them to /auth/login to mint
# a short-lived JWT and auto-refreshes it - nothing to copy by hand.
# INTEGRATION_TOKEN is an optional static override (sent as-is, no refresh); leave
# blank when using the username/password above.
INTEGRATION_BASE_URL=https://integration.andrsn.in
INTEGRATION_USERNAME=
INTEGRATION_PASSWORD=
INTEGRATION_TOKEN=
INTEGRATION_ENABLED=false
